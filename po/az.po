msgstr "Bu proqramdan yalnız root istifadəçisi istifadə edə bilər"

#. TRANSLATORS: error details
#: gs-install-appstream/gs-install-appstream.c:209
#, c-format
msgid "Failed to validate content type: %s"
msgstr "Məzmun növünü doğrulamaq mümkün olmadı: %s"

#. TRANSLATORS: error details
#: gs-install-appstream/gs-install-appstream.c:220
#, c-format
msgid "Failed to move: %s"
msgstr "Daşımaq mümkün olmadı: %s"

